# Hugging Face token with read and Inference Providers permissions.
# Never commit your real .env file.
HF_TOKEN=hf_...

# Optional model overrides used by inference/evaluation notebooks.
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct-1M
HF_JUDGE_MODEL=Qwen/Qwen2.5-7B-Instruct-1M

# Optional vLLM-compatible server settings.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=local-dev-key
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
